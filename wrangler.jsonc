/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-moedict-webkit-neo",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-07",
	"cache": {
		"enabled": true
	},
	"assets": {
		"binding": "SITE_ASSETS",
		"run_worker_first": ["/*", "!/fonts/*", "!/manifest.json"]
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "FONTS",
			"bucket_name": "moedict-fonts",
			"preview_bucket_name": "moedict-fonts-preview",
			"remote": true
		},
		{
			"binding": "ASSETS",
			"bucket_name": "moedict-assets",
			"preview_bucket_name": "moedict-assets-preview",
			"remote": true
		},
		{
			"binding": "DICTIONARY",
			"bucket_name": "moedict-dictionary",
			"preview_bucket_name": "moedict-dictionary-preview",
			"remote": true
		}
	],
	"vars": {
		// ASSET_BASE_URL：有使用。Worker 用於 (1) /api/config 的 assetBaseUrl (2) /assets/* 在 ASSETS 綁定找不到時代理到 R2。前端多處透過 /api/config 載入靜態資源基底路徑。
		"ASSET_BASE_URL": "https://r2-assets.moedict.tw",
		// DICTIONARY_BASE_URL：目前僅由 /api/config 回傳 dictionaryBaseUrl；程式碼庫內尚無讀取該欄位。字典 JSON 實際由 Worker 綁定 DICTIONARY R2（/api/*.json 等）提供，非此公開 URL 直連。
		"DICTIONARY_BASE_URL": "https://r2-dictionary.moedict.tw"
	},
	"env": {
		// 獨立 staging 環境：獨立 Worker 名稱（只有 *.workers.dev，未綁定任何自訂網域/
		// 正式站路由，與 production 完全隔離），指向既有的 R2 -preview 桶（唯讀，與
		// production 桶內容可能存在落差但資料真實可用，見 commands/upload_dictionary.sh
		// 既有的 preview/prod 慣例）。用 `vp run deploy:staging` 部署；.workers.dev 網址
		// 於部署輸出列印，或見 `wrangler deployments list --env staging`。
		"staging": {
			"name": "cf-moedict-webkit-neo-staging",
			"cache": {
				"enabled": true
			},
			"r2_buckets": [
				{
					"binding": "FONTS",
					"bucket_name": "moedict-fonts-preview",
					"remote": true
				},
				{
					"binding": "ASSETS",
					"bucket_name": "moedict-assets-preview",
					"remote": true
				},
				{
					"binding": "DICTIONARY",
					"bucket_name": "moedict-dictionary-preview",
					"remote": true
				}
			],
			"vars": {
				"ASSET_BASE_URL": "https://r2-assets.moedict.tw",
				"DICTIONARY_BASE_URL": "https://r2-dictionary.moedict.tw"
			}
		}
	}
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}