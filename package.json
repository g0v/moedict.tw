{
	"name": "cf-moedict-webkit-neo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"generate-c-index": "node commands/generateCIndex.js",
		"predev": "vp run build-search-index && vp run build-pinyin-lookup",
		"prebuild": "vp run build-search-index && vp run build-pinyin-lookup",
		"build-search-index": "node scripts/build-search-index.mjs",
		"build-pinyin-lookup": "node scripts/build-pinyin-lookup.mjs",
		"build-reader-formats": "node scripts/build-reader-formats.mjs",
		"dev": "vp dev",
		"dev:remote": "VITE_CLOUDFLARE_REMOTE_DEV=1 vp dev",
		"build": "tsc -b && vp build",
		"lint": "vp lint .",
		"lint:type-aware": "vp lint --type-aware --type-check src worker",
		"lint:css": "stylelint \"data/assets/*.css\"",
		"typecheck": "tsc -b --noEmit",
		"typecheck:tsc": "tsc -b --noEmit",
		"smoke:sub-routes": "node scripts/smoke-sub-routes.mjs",
		"check:data": "node scripts/check-dictionary-data.mjs",
		"check:css-ids": "node scripts/check-legacy-css-ids.mjs",
		"check:css-equivalence": "node scripts/check-legacy-css-equivalence.mjs",
		"check:trs": "bun scripts/check-trs-bpmf.mjs",
		"seed:fixtures": "bun tests/seed-fixtures.mjs",
		"test": "vp run test:unit && vp run test:integration && vp run test:e2e",
		"test:unit": "vp test run --project unit",
		"test:unit:watch": "vp test watch --project unit",
		"test:integration": "vp test run --project integration",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:visual": "playwright test --project=visual",
		"test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
		"test:coverage": "rm -rf coverage && vp run test:unit --coverage && vp run test:integration --coverage --coverage.reportsDirectory=coverage/integration --coverage.reporter=text-summary --coverage.reporter=json --coverage.reporter=lcov --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0 && vp run test:coverage:e2e && node scripts/merge-coverage.mjs",
		"test:coverage:e2e": "E2E_COVERAGE=1 vp run build && E2E_COVERAGE=1 E2E_SKIP_BUILD=1 playwright test --project=chromium",
		"stryker": "stryker run",
		"preview": "vp run build && wrangler dev",
		"deploy": "vp run build && wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging vp run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"prepare": "vp config"
	},
	"dependencies": {
		"@cf-wasm/resvg": "^0.1.24",
		"fuse.js": "^7.1.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.13.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.44.0",
		"@playwright/test": "^1.59.1",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@types/node": "^24.7.2",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.0",
		"@vitest/coverage-v8": "4.1.10",
		"happy-dom": "^20.9.0",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"miniflare": "^4.20260708.1",
		"postcss": "^8.5.16",
		"stylelint": "^17.14.0",
		"stylelint-config-standard": "^40.0.0",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"v8-to-istanbul": "^9.3.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
		"vitest": "4.1.10",
		"wrangler": "^4.110.0",
		"vite-plus": "0.2.4"
	},
	"overrides": {
		"undici": "^7.24.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
		"vitest": "4.1.10"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	}
}
