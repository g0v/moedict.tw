  "shard_assignment_rule": {
    "description": "Codepoints map to shards 0-7 according to getTwKaiShardKey(codepoint) in src/utils/image-generation.ts. Target codepoint sets are canonically recorded per-shard below in codepoint_ranges. The build script regenerates shards directly from Fonts_Kai.zip using these tracked ranges, making shard reproduction immune to supporting archive hash drift.",
    "ranges": {
      "shard-0": "codepoint <= 0x4FFF",
      "shard-1": "0x5000 <= codepoint <= 0x7FFF",
      "shard-2": "0x8000 <= codepoint <= 0xFFFF",
      "shard-3": "0x20000 <= codepoint <= 0x22FFF",
      "shard-4": "0x23000 <= codepoint <= 0x24FFF",
      "shard-5": "0x25000 <= codepoint <= 0x27FFF",
      "shard-6": "0x28000 <= codepoint <= 0x2A6DF",
      "shard-7": "codepoint >= 0x2A700"
    }
  },
